    {
      "id": "emetteur",
      "name": "Émetteur",
      "components": [
        {
          "id": "esp1",
          "type": "esp32",
          "x": 100,
          "y": 60,
          "rot": 0,
          "label": "ESP32 émetteur",
          "props": {},
          "code": "// Envoie l'état du bouton (D4 → GND) à toutes les cartes du réseau « atelier »\n#include <WiFi.h>\n#include <WiFiUdp.h>\n\nconst char* ssid = \"atelier\";\nconst char* motDePasse = \"12345678\";\nconst int PORT = 4210;\nconst int BOUTON = 4;\n\nWiFiUDP udp;\nint dernier = -1;\n\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(BOUTON, INPUT_PULLUP);\n  WiFi.begin(ssid, motDePasse);\n  Serial.print(\"Connexion\");\n  while (WiFi.status() != WL_CONNECTED) {\n    delay(100);\n    Serial.print(\".\");\n  }\n  Serial.println();\n  Serial.print(\"Connecté, IP : \");\n  Serial.println(WiFi.localIP());\n  udp.begin(PORT);\n}\n\nvoid loop() {\n  int etat = digitalRead(BOUTON);\n  if (etat != dernier) {\n    dernier = etat;\n    String msg = etat == LOW ? \"ON\" : \"OFF\";\n    udp.beginPacket(WiFi.broadcastIP(), PORT);   // à tout le réseau\n    udp.print(msg);\n    udp.endPacket();\n    Serial.println(\"envoyé : \" + msg);\n  }\n  delay(20);\n}\n",
          "pins": [
            {
              "name": "3V3",
              "side": "left"
            },
            {
              "name": "GND",
              "side": "left"
            },
            {
              "name": "D4",
              "side": "right"
            },
            {
              "name": "D2",
              "side": "right"
            }
          ]
        },
