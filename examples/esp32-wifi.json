      "components": [
        {
          "id": "esp2",
          "type": "esp32",
          "x": 100,
          "y": 60,
          "rot": 0,
          "label": "ESP32 récepteur",
          "props": {},
          "code": "// Reçoit « ON » / « OFF » sur le réseau « atelier » et pilote la LED de D18\n#include <WiFi.h>\n#include <WiFiUdp.h>\n\nconst char* ssid = \"atelier\";\nconst char* motDePasse = \"12345678\";\nconst int PORT = 4210;\nconst int LED = 18;\n\nWiFiUDP udp;\n\nvoid setup() {\n  Serial.begin(115200);\n  pinMode(LED, OUTPUT);\n  WiFi.begin(ssid, motDePasse);\n  while (WiFi.status() != WL_CONNECTED) delay(100);\n  Serial.print(\"IP : \");\n  Serial.println(WiFi.localIP());\n  udp.begin(PORT);\n}\n\nvoid loop() {\n  if (udp.parsePacket()) {\n    String msg = udp.readString();\n    Serial.print(\"reçu de \");\n    Serial.print(udp.remoteIP());\n    Serial.println(\" : \" + msg);\n    digitalWrite(LED, msg == \"ON\" ? HIGH : LOW);\n  }\n  delay(10);\n}\n",
          "pins": [
            {
              "name": "3V3",
              "side": "left"
            },
            {
              "name": "GND",
              "side": "left"
            },
            {
              "name": "D18",
              "side": "right"
            },
            {
              "name": "D2",
              "side": "right"
            }
          ]
        },
